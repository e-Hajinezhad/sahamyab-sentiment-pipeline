# Copy this file to .env and fill in real values.
# .env is in .gitignore and will NOT be committed to git.

# ---------- PostgreSQL (Airflow metadata database) ----------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=airflow

# ---------- MongoDB ----------
# Root user (full admin access to the whole MongoDB server)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me_mongo_root

# App user (used by the DAGs, read/write access to the "analytics" db only)
MONGO_APP_USERNAME=sahamyab_app
MONGO_APP_PASSWORD=change_me_mongo_app

# ---------- ClickHouse ----------
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_DB=analytics

# ---------- Airflow ----------
# Generate a real one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_a_real_fernet_key

# Used to sign web sessions and CSRF tokens. If this isn't set, Airflow
# generates a random one on every webserver restart, which silently
# invalidates any login page/session that was open before the restart
# (shows as "Invalid login" even with the correct password).
# Generate a real one with:
# python -c "import secrets; print(secrets.token_hex(30))"
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_generate_a_real_secret_key

# Login for the Airflow web UI (http://localhost:8080)
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=change_me_airflow_ui
